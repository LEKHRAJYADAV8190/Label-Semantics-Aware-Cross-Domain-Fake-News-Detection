omy"":null,""view"":null,""namespacesRequired"":[]},""initialState"":{""adTest"":{""slots"":[],""articleHeight"":50},""article"":{""loading"":false,""content"":[{""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]},""contentSharing"":[],""type"":""article"",""id"":""ncna449071"",""subType"":""post"",""dek"":""Moscow claims the air operation in Syria is aimed at weakening ISIS. "",""sentiment"":""none"",""content"":{""text"":["""",""Russian President Vladimir Putin's approval rating has reached nearly 90 percent largely thanks to his military moves in Syria, according to a new nationwide poll published Thursday."","""",""State-run pollster VTsIOM said a record 89.9 percent of Russians approved of Putin in its latest weekly survey — up from 86.6 percent a week earlier and above the previous record of 89.1 in June 2015."",""\""Such high approval rating of the president of Russia had to do mostly with the events in Syria, [and] Russian airstrikes on terrorist positions,\"" VTsIOM said on its website."",""Moscow claims the air operation in Syria is aimed at weakening ISIS. Western officials have questioned whether Russia is actually targeting moderate rebels in a move to bolster its flagging ally, Syrian President Bashar Assad."",""Related: Assad Goes to Moscow to Say Thanks to Putin"",""Putin’s rating had been hovering above 80 percent since spring 2014, when Russia annexed Ukraine’s Crimea peninsula and endorsed a bloody pro-Russian uprising in eastern Ukraine."",""With the latest VTsIOM poll, Putin's popularity is now just a notch below that of Central Asian dictators — who can often rack up between 90 and 97 percent of votes in elections."",""While VTsIOM is a respected pollster, analysts have long questioned Russian approval polls. Studies show that in authoritarian states, polls can overstate the popularity of incumbent leaders by between 5 and 20 percent because many respondents give the answers that they think are expected of them."",""Related: Syrians Say Russian Airstrikes Bring 'Massive Destruction'"",""The latest figures come amid a prolonged economic slump. Official data released earlier this week shows Russian household income has been decreasing for the past 11 months."",""Almost half of respondents in last month’s VTsIOM poll last month said they expected the economic crisis to get worse."",""VTsIOM said it polled 1,600 people and that the poll's margin of error was 3.5 percentage points.""]},""documentTracing"":{""currentMessageId"":null,""correlationID"":""61811790-6312-4e67-9e39-52c8be08922f"",""type"":""article""},""flag"":null,""unibrow"":{""logo"":null,""taxonomyPath"":""nbcnews/section/news/world"",""text"":""World"",""url"":{""primary"":null}},""primaryMedia"":{""autoplay"":true,""disablePlaylistAutoplay"":false,""presentation"":{""alignment"":""left"",""size"":""medium"",""style"":""default"",""byline"":null,""hideRecommendations"":false,""hideProductRecommendations"":false},""type"":""embeddedVideo"",""video"":{""id"":""mmvo42680901927"",""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]},""associatedVideoPlaylist"":{""id"":""mmlsnnd_21426473-nnd"",""headline"":{""primary"":""World News""},""videos"":[{""type"":""video"",""id"":""mmvo271118405853"",""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]},""unibrow"":{""logo"":null,""taxonomyPath"":null,""text"":""Current with Christine Romans"",""url"":{""primary"":null}},""mpxMetadata"":{""id"":""271118405853"",""guid"":""now_current_paris_protests_highschool_engel_261006"",""externalAdvertiserId"":""now_current_paris_protests_highschool_engel_261006""},""datePublished"":""Tue Oct 06 2026 15:39:50 GMT+0000 (UTC)"",""dateCreated"":""Tue Oct 06 2026 15:39:49 GMT+0000 (UTC)"",""dateModified"":""Tue Oct 06 2026 15:40:35 GMT+0000 (UTC)"",""date"":{""publishedAt"":""2026-10-06T15:39:50.000Z"",""createdAt"":""2026-10-06T15:39:49.000Z"",""modifiedAt"":""2026-10-06T15:40:35.000Z""},""primaryImage"":{""id"":""vidimg596479367"",""hea