mage/upload/newscms/2017_16/1973556/170422-dylann-roof-1113a-rs.JPG"",""telemundo"":null},""encodingFormat"":""image/jpeg"",""height"":1652,""width"":2500,""authors"":[{""name"":""Grace Beahm/Pool""}],""source"":{""name"":""Reuters"",""copyright"":null},""graphicContent"":false,""imageContentType"":null},""socialImage"":{""id"":""ncim1973556"",""headline"":{""primary"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""tease"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""seo"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""social"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017.""},""caption"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""altText"":""Image: Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""url"":{""primary"":""https://media-cldnry.s-nbcnews.com/image/upload/newscms/2017_16/1973556/170422-dylann-roof-1113a-rs.JPG""},""imageUrl"":{""aims"":""https://media4.s-nbcnews.com/i/newscms/2017_16/1973556/170422-dylann-roof-1113a-rs_026b07807538aaf15d8b07c31a2aecae.JPG"",""cloudinary"":""https://media-cldnry.s-nbcnews.com/image/upload/newscms/2017_16/1973556/170422-dylann-roof-1113a-rs.JPG"",""telemundo"":null},""encodingFormat"":""image/jpeg"",""height"":1652,""width"":2500,""authors"":[{""name"":""Grace Beahm/Pool""}],""source"":{""name"":""Reuters"",""copyright"":""""},""graphicContent"":false,""imageContentType"":null},""experts"":[],""authors"":[{""type"":""embeddedPerson"",""authorType"":""author"",""featuredAuthor"":{""isFeaturedAuthor"":false},""person"":{""bio"":[],""dateCreated"":""Thu Jan 26 2017 20:58:23 GMT+0000 (UTC)"",""dateModified"":""Wed Mar 24 2021 16:10:01 GMT+0000 (UTC)"",""shortBio"":null,""liveBlogShortBio"":"""",""experience"":[],""educationAndExpertise"":[],""awards"":[],""id"":""ncpn712731"",""email"":""avalon.zoppo@nbcuni.com"",""jobTitle"":[],""name"":""Avalon Zoppo"",""primaryImage"":null,""publisher"":{""name"":""nbcnews"",""subType"":null,""type"":""organization""},""socialMediaProfiles"":{""email"":null,""facebook"":null,""instagram"":null,""pinterest"":null,""snapchat"":null,""tiktok"":null,""twitter"":null,""whatsapp"":null,""youtube"":null,""mastodon"":null,""threads"":null,""signal"":null},""subType"":null,""type"":""person"",""url"":null,""worksFor"":null,""content"":{""pagination"":{""offset"":0,""page"":1,""size"":3,""totalItems"":0,""totalPages"":0},""items"":[]}}}],""adsEnabled"":true,""ecommerceEnabled"":false,""sponsoredBy"":null,""hidden"":false,""searchable"":true,""nativeAd"":false,""breakingNews"":false,""breakingTagDisabled"":true,""body"":[{""type"":""markup"",""element"":""p"",""html"":""Convicted church shooter Dylann Roof has been transferred to death row at Terre Haute Federal Prison in Indiana — the facility that houses male inmates awaiting execution under the federal government."",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""markup"",""element"":""p"",""html"":""Roof, the first person to be convicted of a federal hate crime and sentenced to the death penalty, was removed from custody in Al Cannon Detention Center in North Charleston, South Carolina, on Friday and transferred to Terre Haute, prison records show."",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""markup"",""element"":""p"",""html"":""Terre Haute, a medium-security prison where inmates are put to death by lethal injection, \u003ca href=\""https://www.bop.gov/locations/institutions/tha/\""\u003ecurrently houses 1,338 inmates\u003c/a\u003e."",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""presentation"":{""alignment"":""left"",""size"":""medium"",""style"":""default"",""byline"":null,""hideRecommendations"":false,""hideProductRecommendations"":false},""type"":""embeddedImage"",""image"":{""id"":""ncim1973556"",""headline"":{""primary"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""tease"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""seo"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""social"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017.""},""caption"":""Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""altText"":""Image: Dylann Roof is escorted into the court room at the Charleston County Judicial Center in Charleston, South Carolina, April 10, 2017."",""url"":{""primary"":""https://media-cldnry.s-nbcnews.com/image/upload/newscms/2017_16/1973556/170422-dylann-roof-1113a-rs.JPG""},""imageUrl"":{""aims"":""https://media4.s-nbcnews.com/i/newscms/2017_16/1973556/170422-dylann-roof-1113a-rs_026b07807538aaf15d8b07c31a2aecae.JPG"",""cloudinary"":""https://media-cldnry.s-nbcnews.com/image/upload/newscms/2017_16/1973556/170422-dylann-roof-1113a-rs.JPG"",""telemundo"":null},""encodingFormat"":""image/jpeg"",""height"":1652,""width"":2500,""authors"":[{""name"":""Grace Beahm/Pool""}],""source"":{""name"":""Reuters"",""copyright"":""""},""graphicContent"":false,""imageContentType"":null},""elementId"":null},{""type"":""markup"",""element"":""p"",""html"":""In \u003ca href=\""http://www.nbcnews.com/storyline/charleston-church-shooting/dylann-roof-sentenced-death-charleston-church-massacre-n705376\""\u003eJanuary\u003c/a\u003e, a jury sentenced the self-proclaimed white supremacist to death for killing nine black worshipers in June 2015 at Emmanuel AME Church in Charleston during a Bible study. The 23-year-old told FBI agents that he was trying to start a race war."",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""markup"",""element"":""p"",""html"":""He also \u003ca href=\""http://www.nbcnews.com/news/us-news/dylann-roof-charleston-church-shooter-pleads-guilty-state-charges-n744746\""\u003epleaded guilty\u003c/a\u003e to nine counts of state murder charges on April 10."",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""markup"",""element"":""p"",""html"":""Roof is now among the long list of well-known criminals who have spent time in the Indiana facility. Others include murderer and drug trafficker Raul Garza and Oklahoma City bomber Timothy McVeigh."",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""markup"",""element"":""p"",""html"":""\u003cstrong\u003e\u003ca href=\""http://www.nbcnews.com/storyline/lethal-injection\""\u003eRead more about the lethal injection controversy here\u003c/a\u003e\u003c/strong\u003e"",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""markup"",""element"":""p"",""html"":""As of Feb. 9, there were 62 federal inmates on death row, according to the \u003ca href=\""https://deathpenaltyinfo.org/federal-death-row-prisoners#list\""\u003eDeath Penalty Information Center. \u003c/a\u003eThree inmates have been on death row since 1993 — drug gang members Richard Tipton, James Roane Jr. and Corey Johnson, who were convicted of killing nine people\u003ca href=\""http://www.nytimes.com/1993/02/19/us/3-sentenced-to-death-under-us-drug-law.html\""\u003e to protect their crack trade.\u003c/a\u003e"",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""markup"",""element"":""p"",""html"":""Boston bomber Dzhokhar Tsarnaev, who a jury in 2015 recommended be put to death, remains in a federal lockup in Colorado, where officials say they can better handle his \""unique\"" security arrangements."",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""markup"",""element"":""p"",""html"":""After the federal death penalty was suspended by a 1972 U.S. Supreme Court decision, it was brought back 16 years later and three people have since been executed under it."",""elementId"":null,""dataAttributes"":[],""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]}},{""type"":""embeddedVideo"",""disablePlaylistAutoplay"":false,""presentation"":{""alignment"":""left"",""size"":""medium"",""style"":""default"",""byline"":null,""hideRecommendations"":false,""hideProductRecommendations"":false},""video"":{""id"":""mmvo43430469589"",""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]},""associatedVideoPlaylist"":{""id"":""mmlsnnd_54103030-nnd"",""headline"":{""primary"":""Debunker""},""videos"":[{""type"":""video"",""id"":""mmvo43365957796"",""contentRules"":{""contentClassifications"":[""UNRESTRICTED""]},""unibrow"":{""logo"":null,""taxonomyPath"":null,""text"":""Debunker"",""url"":{""primary"":null}},""mpxMetadata"":{""id"":""43365957796"",""guid"":""a_debunker_melber_miranda_160613"",""externalAdvertiserId"":""a_debunker_melber_miranda_160613""},""datePublished"":""Mon Jun 13 2016 15:29:35 GMT+0000 (UTC)"",""dateCreated"":""Sat Nov 17 2018 01:48:48 GMT+0000 (UTC)"",""dateModified"":""Sun Mar 01 2026 21:40:07 GMT+