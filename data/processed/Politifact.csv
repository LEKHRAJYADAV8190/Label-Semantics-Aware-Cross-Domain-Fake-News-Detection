e-8e8e-b8c562fa3f20\u002F1280x720\u002Fmatch\u002Fimage.jpg"",""data-duration"":""5:21""},{contentId:""7d1c1a69-07b7-54a5-be09-9095caee74ff"",title:""Holly Madison hopes to recreate one of her favorite moments at Grant a Gift Gala"",url:""https:\u002F\u002Fwww.foxnews.com\u002Fvideo\u002F6406362679112"",imageUrl:""https:\u002F\u002Fcf-images.us-east-1.prod.boltdns.net\u002Fv1\u002Fstatic\u002F694940094001\u002Fa8e56a26-fb26-4d2b-9fad-93a0c498b61d\u002Fafa11567-637d-4457-8a88-d600c8b4b269\u002F1280x720\u002Fmatch\u002Fimage.jpg"",""data-duration"":""0:45""}],canScrollPrev:b,canScrollNext:c,isSticky:b,originalOffsetTop:s,scroller:h,cname:a,pIndex:fm,primaryName:a,regionName:a}},error:h,state:{ActualContent:{actualContent:""articleLayout""},Articles:{fullArticles:{""foxnews.com/us/ohio-student-suspended-for-staying-in-class-during-national-walkout-day"":{branding:{fn__disclaimer:a,fn__campaign_id:a,advertorial:b,fn__indicator:a},livefyre__:{collection_meta_token:a,reviews_config:""name=\""livefyrereviewsconfig\"" collectionMeta=\""eyJhbGciOiJIUzI1NiJ9..T9vBNJ6HSeWlUZcCsxsz0cJFluHnq4dvpdUOpCE1R_U\"" checksum=\""24abee9cead8eae88d8c3f762e60d699\"" articleId=\""c3d262d4-8da5-4bcc-81df-abae8ced2faereviews\"" siteId=\""310256\"" enable=\""true\"""",comments:c,blog_config:""name=\""livefyreblogconfig\"" collectionMeta=\""eyJhbGciOiJIUzI1NiJ9..inrri770Cq2PMavJfmhC_smu9TL8YPYxx4mxC4uJZtM\"" checksum=\""c8c9333ad2fb005e34d265b4e2cdb726\"" articleId=\""c3d262d4-8da5-4bcc-81df-abae8ced2faeblog\"" siteId=\""310256\"" enable=\""false\"""",collection_checksum:a,storify:b,site_id:""310256"",config:""name=\""livefyreconfig\"" collectionMeta=\""eyJhbGciOiJIUzI1NiJ9..czYIIw8kY9dYAiLbFWKs-VrsW4fmZ_6JUWBEyoV3Fo8\"" checksum=\""dd8e42897cb4d929c49aed32fb9170da\"" articleId=\""c3d262d4-8da5-4bcc-81df-abae8ced2fae\"" siteId=\""310256\"" enable=\""true\""""},last_modified_date:dz,fn__featured:b,dek:E,fn__sources:[{wp__origin:{site:fn,environment:i,blog_id:g,post_id:189,post_type:""source"",source:j},id:""da0f7f21-6535-5be9-82c4-469d7c765f30"",label:v,canonical_url:""foxnews.com\u002Fsource\u002Ffox-news"",url:dA}],short_urls:[fo],social_title:f,fn__breaking_news_start_date:a,fn__app_title:f,fn__breaking_news:b,id:fp,fn__site_search:c,post_status:y,fn__syndication_info:{unique_id:""urn:publicid:ap.org:6488fb8ebbf24634b836cb24db3ecac7"",disable_updates:c},fn__distribution_platforms:{google_news:{amp:c,standout:b,live_coverage:b},facebook_instant_articles:{enabled:c},web:{enabled:c},android:{enabled:c},apple_news:{notification_dates:[],enabled:b,enabled_date:""2018-03-16T23:33:00Z""},ios:{enabled:c},search_engines:{enabled:b}},thumbnail:{image:{url:l},content_type:p,content:{thumbnail:l,brightcove_account:I,description:U,id:w,canonical_url:V,title:x,video_domain:F}},social_description:a,fn__apple_news_title:f,standfirst:a,wp__origin:{site:fn,environment:i,blog_id:g,post_id:1964840,post_type:""post"",source:j,post_status:y},article_slug:""ohio-student-suspended-for-staying-in-class-during-national-walkout-day"",published:c,canonical_url:""foxnews.com\u002Fus\u002Fohio-student-suspended-for-staying-in-class-during-national-walkout-day"",fn__external_feeds_title:f,fn__breaking_news_end_date:a,last_published_date:fq,vanity_urls:[""foxnews.com\u002Fus\u002F2018\u002F03\u002F16\u002Fohio-student-suspended-for-staying-in-class-during-national-walkout-day.html"",""foxnews.com\u002Fus\u002F2018\u002F03\u002F16\u002Fohio-student-suspended-for-staying-in-class-during-walkouts.html""],fn__stock_ticker_symbols:a,vanity_slugs:[""ohio-student-suspended-for-staying-in-class-during-national-walkout-day.html"",""ohio-student-suspended-for-staying-in-class-during-walkouts.html""],wp__category:{path:J,isa_value:n,title:o,slug:n},fn__image:{image:{url:l},content_type:p,content:{thumbnail:l,brightcove_account:I,description:U,id:w,canonical_url:V,title:x,video_domain:F}},fn__legacy_type:W,components:[{is:""VideoInline"",props:{type:p,title:x,caption:U,videoId:w,imageUrl:l,originalImageUrl:l,url:V,videoDomain:F,isFeatured:c}},{is:d,props:{text:""An Ohio high school student said he tried to stay apolitical during the National Walkout Day over gun violence but was suspended for his choice to remain in a classroom instead of joining protests or the alternative, going to study hall.""}},{is:d,props:{text:""Jacob Shoemaker, a senior at Hilliard Davidson High School, said he didn’t want to take sides in the gun-control debate consuming the country. If he went outside for the walkout, he said, he would be supporting gun control. If he stayed in the common area of the school, he said, he would be seen as supporting gun violence and disrespecting the 17 lives lost in the Parkland, Fla. High school shooting the month before.""}},{is:d,props:{text:""Jacob had met with the school’s principal on Tuesday, a day before the rally, for about an hour to find out what exactly the walkout was supporting. But he said the principal reportedly told him it was for the “students to express themselves.”""}},{is:d,props:{text:""\u003Cb\u003E\u003Ca href=\""http:\u002F\u002Fwww.foxnews.com\u002Fus\u002F2018\u002F03\u002F12\u002Fcollege-student-kicked-out-class-for-telling-professor-there-are-only-two-genders.html\""\u003ECOLLEGE STUDENT KICKED OUT OF CLASS FOR TELLING PROFESSOR THERE ARE ONLY TWO GENDERS\u003C\u002Fa\u003E\u003C\u002Fb\u003E""}},{is:d,props:{text:""This left Jacob wondering if it was a memorial for the lives lost or a show of support for gun control.""}},{is:d,props:{text:""He decided, instead, to stay in class for about 20 minutes doing homework after his teacher and fellow classmates left and locked the door.""}},{is:d,props:{text:""When they returned, he was slapped with a suspension.""}},{is:""ArticleImage"",props:{type:""inline"",caption:""An Ohio high school student was suspended for staying in the classroom during the National Walkout Day."",imageAlt:""Ohio school suspension shoemaker"",url:""https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F1200\u002F675\u002Fohio-school-suspension-1.jpg?ve=1&tl=1"",baseImage:""https:\u002F\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002Fohio-school-suspension-1.jpg"",externalUrl:a,externalUrlRel:a,copyright:""Jacob Shoemaker"",source:a,isFeatured:b,isSpotlight:b,keepNaturalRatio:b,imageWidth:fr,imageHeight:fr,responsiveImages:[{src:""https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F343\u002F192\u002Fohio-school-suspension-1.jpg?ve=1&tl=1, https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F686\u002F384\u002Fohio-school-suspension-1.jpg?ve=1&tl=1 2x"",media:""(max-width: 767px)"",width:343,height:192},{src:""https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F672\u002F378\u002Fohio-school-suspension-1.jpg?ve=1&tl=1, https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F1344\u002F756\u002Fohio-school-suspension-1.jpg?ve=1&tl=1 2x"",media:""(min-width: 768px) and (max-width: 1023px)"",width:672,height:378},{src:""https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F931\u002F523\u002Fohio-school-suspension-1.jpg?ve=1&tl=1, https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F1862\u002F1046\u002Fohio-school-suspension-1.jpg?ve=1&tl=1 2x"",media:""(min-width: 1024px) and (max-width: 1279px)"",width:931,height:523},{src:""https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F720\u002F405\u002Fohio-school-suspension-1.jpg?ve=1&tl=1, https:\u002F\u002Fa57.foxnews.com\u002Fstatic.foxnews.com\u002Ffoxnews.com\u002Fcontent\u002Fuploads\u002F2018\u002F09\u002F1440\u002F810\u002Fohio-school-suspension-1.jpg?ve=1&tl=1 2x"",media:""(min-width: 1280px)"",width:$,height:405}]}},{is:d,props:{text:""Jacob’s father, Scott Shoemaker, said his son was just trying to stay neutral – and did nothing wrong.""}},{is:d,props:{text:""“Politics [doesn’t] belong in the school,” he said. “Students shouldn’t be pressured into taking a side.”""}},{is:d,props:{text:""\u003Cb\u003E\u003Ca href=\""http:\u002F\u002Fwww.foxnews.com\u002Fus\u002F2018\u002F03\u002F16\u002Fstudent-with-trump-flag-assaulted-by-mob-during-national-school-walkout.html\""\u003ESTUDENT WITH ‘TRUMP’ FLAG ASSAULTED BY MOB DURING NATIONAL SCHOOL WALKOUT\u003C\u002Fa\u003E\u003C\u002Fb\u003E""}},{is:d,props:{text:""The story went viral after Jacob sent a photo of his out-of-school suspension citation to one of his friends, who posted it on social media.""}},{is:d,props:{text:""The school, as well as the Shoemakers, have received death threats and hate messages.""}},{is:""RelatedMedia"",props:{type:p,title:""Op-ed: Parents were misled about walkout"",caption:""Thousands of students walk out for gun control and to honor Parkland victims. Julie Gunlock makes her case."",videoId:""5751930141001"",imageUrl:fs,originalImageUrl:fs,url:""http:\u002F\u002Fvideo.foxnews.com\u002Fv\u002F5751930141001"",videoDomain:F,isFeatured:b}},{is:d,props:{text:""Scott Shoemaker said his son was just trying to be introspective – and he wasn’t acting out.""}},{is:d,props:{text:""“He didn’t do anything to deserve this,” he said. “He didn’t ask for this.”""}},{is:d,props:{text:""\u003Cb\u003E\u003Ca href=\""http:\u002F\u002Fwww.foxnews.com\u002Fus\u002F2018\u002F03\u002F16\u002Fchicago-students-allegedly-trash-walmart-during-national-school-walkout-protest.html\""\u003ECHICAGO STUDENTS ALLEGEDLY TRASH WALMART DURING NATIONAL SCHOOL WALKOUT PROTEST\u003C\u002Fa\u003E\u003C\u002Fb\u003E""}},{is:d,props:{text:""The district says it's responsible for students' safety and they can't be unsupervised.\u003Ci\u003E\u003C\u002Fi\u003E""}},{is:d,props:{text:""\u003Ci\u003EThe Associated Press contributed to this report.\u003C\u002Fi\u003E""}}],fn__section_title:f,dateline:a,fn__footer:a,title:f,fn__type:""articles"",short_title:f,publication_date:ft,wp__tags:[{path:A,isa_value:k,title:e,slug:k},{path:fu,isa_value:fv,title:""Controversies"",slug:""controversies-education""}],spark_id:fp,comments:{enabled:c},fn__sections:[{path:J,isa_value:n,id:ab}],fn__story_type:""Migrated"",fn__fbia_title:f,articleId:""c3d262d4-8da5-4bcc-81df-abae8ced2fae"",social_image:{image:{url:l},content_type:p,content:{thumbnail:l,brightcove_account:I,description:U,id:w,canonical_url:V,title:x,video_domain:F}},fn__tags:[{path:A,isa_value:k,id:r},{path:fu,isa_value:fv,id:""ca226f6f-c8d6-516c-bd88-4f8c7205a27c""}],full_span_image:{},fn__contributors:[{full_name:dB,id:""0afc9bd0-62ba-5439-adfa-ef4d4d3e55d4"",name_id:""caleb-parke"",person_id:""content\u002Ffox-news\u002Fperson\u002Fp\u002Fcaleb-parke""}],created_date:fw,fn__additional_authors:[a],isAMP:b,originalCanonical_url:fx,header:{headline:f,subHeadline:a,authors:[{name:dB,url:a},{name:a,url:a}],source:{name:v,url:dA},allowComments:c,publicationDate:ft,modifiedDate:dz,lastPublishedDate:fq,headerCategory:{name:e,url:""\u002Fcategory\u002Fus\u002Feducation""},category:{name:o,url:ez},organizationName:v,organizationUrl:dA},overlayType:W}},ampCSS:""\u002F*! updated; 10-06-2026 11:52 AM **\u002F:root,html[data-theme=light]{--background:#ffffff;--background-darker-1:#f6f8fa;--background-input-field:#ffffff;--thumb_background:#f4f4f4;--dek_background:#666666;--duration_background:#222222;--divider_color:#cccccc;--focused_border_color:#cccccc;--focused_container_box_shadow_color:rgba(0, 0, 0, 0.16);--container_box_shadow_color:rgba(0, 0, 0, 0.08);--border:#dddddd;--duration_text_color:#f4f4f4;--title_color:#222222;--brand_primary-lighter-1:#4b78a7;--brand_primary-lighter: