constitutional-investigation-into-protesters-271125573792"",""short"":""https://www.nbcnews.com/now/video/fbi-whistleblower-says-white-house-pushed-unconstitutional-investigation-into-protesters-271125573792"",""slug"":""fbi-whistleblower-says-white-house-pushed-unconstitutional-investigation-into-protesters-271125573792""},""relatedUrl"":null,""relatedContentLink"":{""text"":null,""url"":null},""duration"":""PT1M52S"",""nativeAd"":false,""videoType"":""broadcast"",""sentiment"":""neutral"",""headline"":{""primary"":""FBI whistleblower: WH pushed unconstitutional investigation into protesters"",""tease"":""FBI whistleblower: WH pushed unconstitutional investigation into protesters"",""social"":""FBI whistleblower: WH pushed unconstitutional investigation into protesters""},""description"":{""primary"":""An FBI whistleblower alleges the White House pushed the FBI to investigate demonstrators in L.A. and called it a violation of their constitutional rights. NBC News’ Kelly O’Donnell details what else was in the complaint and how the White House is reacting. ""},""publisher"":{""name"":""nbcnews""},""source"":{""name"":""NBC News NOW"",""roles"":[]},""taxonomy"":{""additionalTerms"":[{""dateCreated"":""Thu Sep 16 2021 03:10:17 GMT+0000 (UTC)"",""dateModified"":""Thu Sep 16 2021 03:10:17 GMT+0000 (UTC)"",""description"":{""primary"":null},""id"":""nctx17741"",""isCurated"":true,""name"":""Immigration"",""path"":""nbcnews/section/politics/immigration"",""pageRoute"":""/politics/immigration"",""slug"":""immigration"",""type"":""taxonomy"",""taxonomyType"":""topic"",""url"":{""primary"":""https://www.nbcnews.com/politics/immigration""}},{""dateCreated"":""Thu Sep 16 2021 03:10:20 GMT+0000 (UTC)"",""dateModified"":""Thu Sep 16 2021 03:10:20 GMT+0000 (UTC)"",""description"":{""primary"":null},""id"":""nctx36"",""isCurated"":true,""name"":""Justice Department"",""path"":""nbcnews/section/politics/justice-department"",""pageRoute"":""/politics/justice-department"",""slug"":""j