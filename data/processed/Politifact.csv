81d/rand-paul-time-100-2x.jpg?branch=production\u0026width=384\u0026quality=75\u0026auto=webp\u0026crop=1:1 384w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=480\u0026quality=75\u0026auto=webp\u0026crop=1:1 480w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=640\u0026quality=75\u0026auto=webp\u0026crop=1:1 640w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=750\u0026quality=75\u0026auto=webp\u0026crop=1:1 750w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=828\u0026quality=75\u0026auto=webp\u0026crop=1:1 828w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=1080\u0026quality=75\u0026auto=webp\u0026crop=1:1 1080w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=1200\u0026quality=75\u0026auto=webp\u0026crop=1:1 1200w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=1440\u0026quality=75\u0026auto=webp\u0026crop=1:1 1440w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=1920\u0026quality=75\u0026auto=webp\u0026crop=1:1 1920w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=2400\u0026quality=75\u0026auto=webp\u0026crop=1:1 2400w, https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=3840\u0026quality=75\u0026auto=webp\u0026crop=1:1 3840w86:[false,[\""$\"",\""img\"",null,{\""ref\"":\""$undefined\"",\""alt\"":\""Rand Paul\"",\""loading\"":\""lazy\"",\""width\"":640,\""height\"":640,\""decoding\"":\""async\"",\""className\"":\""object-cover aspect-1/1 lg:aspect-1/1 size-12 overflow-hidden rounded-full\"",\""style\"":{\""color\"":\""transparent\""},\""sizes\"":\""48px\"",\""srcSet\"":\""$87\"",\""src\"":\""https://static.time.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\u0026width=3840\u0026quality=75\u0026auto=webp\u0026crop=1:1\""}]]\n7c:[\""$\"",\""div\"",null,{\""ref\"":\""$undefined\"",\""className\"":\""col-span-full mt-3 lg:mt-6 lg:hidden\"",\""children\"":[[\""$\"",\""div\"",null,{\""className\"":\""border-b pb-4 border-warm-grey-2\"",\""children\"":[\""$\"",\""div\"",null,{\""className\"":\""flex flex-col gap-4\"",\""children\"":[[\""$\"",\""div\"",null,{\""className\"":\""flex flex-row items-center gap-2\"",\""children\"":[[\""$\"",\""div\"",null,{\""className\"":\""flex flex-col\"",\""children\"":[\""$\"",\""picture\"",null,{\""className\"":\""$undefined\"",\""children\"":\""$86\""}]}],[\""$\"",\""div\"",null,{\""children\"":[[\""$\"",\""div\"",null,{\""className\"":\""mb-1 flex font-graphik-compact text-t4 text-black-coffee\"",\""children\"":[[\""$\"",\""span\"",null,{\""className\"":\""mr-1\"",\""children\"":\""by \""}],[\""$\"",\""div\"",null,{\""className\"":\""inline-flex flex-wrap items-center\"",\""children\"":[[\""$\"",\""$L23\"",null,{\""href\"":\""https://time.com/author/sen-rand-paul/\"",\""className\"":\""underline hover:text-brand-red focus-visible:outline focus-visible:outline-black-coffee focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:shadow-focus-color\"",\""gtmData\"":{\""event\"":\""internalClick\"",\""componentType\"":\""standard hero_author modal\"",\""articleName\"":\""Rand Paul: We Must Demilitarize the Police\"",\""publishDate\"":\""2026-08-04T08:13:09.792Z\"",\""updateDate\"":\""2026-08-04T07:44:24.432Z\"",\""articleType\"":\""Standard\"",\""author\"":\""Sen. Rand Paul\"",\""authorId\"":\""bltccc130f00415278a\"",\""authorType\"":\""contributor\""},\""children\"":\""Rand Paul\""}],\""\""]}],[\""$\"",\""$L75\"",null,{\""followedObjectType\"":\""author\"",\""followedObject\"":{\""name\"":\""Rand Paul\"",\""url\"":\""/author/sen-rand-paul/\"",\""id\"":\""bltccc130f00415278a\"",\""thumbnail\"":\""https://gcp-na-images.contentstack.com/v3/assets/bltea6093859af6183b/blt1dd975d1ad17c6a0/69868bb61eebf71d7737081d/rand-paul-time-100-2x.jpg?branch=production\""},\""className\"":\""ml-2\""}]]}],\""\""]}]]}],\""\"",false]}]}],[\""$\"",\""div\"",null,{\""className\"":\""flex flex-col gap-1 font-graphik-compact text-caption-small lg:flex-row lg:items-center text-grey-1 mt-3\"",\""children\"":[false,false,[\""$\"",\""span\"",null,{\""children\"":[\""\"",\"" \"",[\""$\"",\""$L84\"",null,{\""time\"":\""2014-08-14T16:26:37.000Z\""}]]}]]}]]}]\n8a:[[\""1ec00976fc6b4ef38a3e4aa9c66ad8ee\"",\""witness-tension-between-police-and-protestors-in-ferguson-mo\""]]\n7d:[\""$\"",\""div\"",null,{\""ref\"":\""$undefined\"",\""className\"":\""container mx-auto max-w-[90rem] px-6 lg:px-20 group/header-newsletter\"",\""children\"":[false,[\""$\"",\""div\"",null,{\""className\"":\""grid gap-x-4 grid-cols-4 lg:grid-cols-12\"",\""children\"":[[\""$\"",\""div\"",null,{\""ref\"":\""$undefined\"",\""className\"":\""relative col-span-full lg:col-span-8 lg:col-start-2 lg:w-[632px]\"",\""children\"":[[\""$\"",\""article\"",null,{\""id\"":\""article-body\"",\""className\"":\""pb-8 has-[[data-article-actions-pills]]:!pt-0 lg:pb-0 lg:has-[[data-article-actions-pills]]:!pt-6 pt-3 group-has-[[data-testid=marfeel-article-header-newsletter-wrapper]_section]/header-newsletter:pt-8 lg:pt-10 lg:group-has-[[data-testid=marfeel-article-header-newsletter-wrapper]_section]/header-newsletter:pt-10\"",\""children\"":[[\""$\"",\""$L88\"",null,{\""actions\"":[],\""articleName\"":\""Rand Paul: We Must Demilitarize the Police\""}],null,[[\""$\"",\""div\"",\""block-group-ArticleBlocksHtml-0\"",{\""children\"":[[[\""$\"",\""$1\"",\""inner-block-ArticleBlocksHtml-0\"",{\""children\"":[\""$\"",\""$L89\"",null,{\""block\"":{\""__typename\"":\""ArticleBlocksHtml\"",\""html\"":{\""__typename\"":\""Html\"",\""html\"":{\""__typename\"":\""HtmlHtml\"",\""json\"":{\""uid\"":\""788306bf33b24c6ea74535b533290674\"",\""type\"":\""doc\"",\""children\"":[{\""uid\"":\""92cfdd2c94844f928e3e2751f1c18522\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""The shooting of 18-year-old Michael Brown is an awful tragedy that continues to send shockwaves through the community of Ferguson, Missouri and across the nation.\""}]},{\""uid\"":\""bd815a9237e24dee8b7dde938ff072a4\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""If I had been told to get out of the street as a teenager, there would have been a distinct possibility that I might have smarted off. But, I wouldn’t have expected to be shot.\""}]},{\""uid\"":\""3d2ea026e07647c7bad7dc3175357f2d\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""The outrage in Ferguson is understandable—though there is never an excuse for rioting or looting. There is a legitimate role for the police to keep the peace, but there should be a difference between a police response and a military response.\""}]},{\""uid\"":\""a183d31a14cd4ac496039b8882535f90\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""The images and scenes we continue to see in Ferguson resemble war more than traditional police action.\""}]},{\""uid\"":\""33c7f89d519d4066a4f41fe1bd1f5fcc\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Glenn Reynolds, in \""},{\""uid\"":\""283b628426644cc393a06506e99940b6\"",\""type\"":\""a\"",\""attrs\"":{\""url\"":\""http://www.popularmechanics.com/technology/military/4203345?click=main_sr\"",\""target\"":\""_blank\""},\""children\"":[{\""text\"":\""Popular Mechanics\""}]},{\""text\"":\"", recognized the increasing militarization of the police five years ago. In 2009 he wrote:\""}]},{\""uid\"":\""fac9dc97e7ac49db803ac65903311485\"",\""type\"":\""blockquote\"",\""attrs\"":{\""class-name\"":\""quote\""},\""children\"":[{\""uid\"":\""da1220ef1f6340d09efb0ff7f51a2912\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Soldiers and police are supposed to be different. ... Police look inward. They’re supposed to protect their fellow citizens from criminals, and to maintain order with a minimum of force.\""}]},{\""uid\"":\""ac8354dc10f24b1d9df144748fcfda5a\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""It’s the difference between Audie Murphy and Andy Griffith. But nowadays, police are looking, and acting, more like soldiers than cops, with bad consequences. And those who suffer the consequences are usually innocent civilians.\""}]}]},{\""uid\"":\""95c9ed7d9ef24cd5a6bb28e9f9cfb36e\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""uid\"":\""b9b36712e74349a2beb481fb2ec26591\"",\""type\"":\""a\"",\""attrs\"":{\""url\"":\""http://www.cato.org/blog/police-militarization-ferguson-nationwide\"",\""target\"":\""_blank\""},\""children\"":[{\""text\"":\""The Cato Institute’s\""}]},{\""text\"":\"" Walter Olson observed this week how the rising militarization of law enforcement is currently playing out in Ferguson:\""}]},{\""uid\"":\""3e9f151033404dc6b7253298efb2513e\"",\""type\"":\""blockquote\"",\""attrs\"":{\""class-name\"":\""quote\""},\""children\"":[{\""uid\"":\""c26b6d2815b54fe09bdd37dc929634f1\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Why armored vehicles in a Midwestern inner suburb? Why would cops wear camouflage gear against a terrain patterned by convenience stores and beauty parlors? Why are the authorities in Ferguson, Mo. so given to quasi-martial crowd control methods (such as bans on walking on the street) and, per the reporting of \""},{\""text\"":\""Riverfront Times\"",\""italic\"":true},{\""text\"":\"", the firing of tear gas at people in their own yards? (“‘This my property!’ he shouted, prompting police to fire a tear gas canister directly at his face.”) Why would someone identifying himself as an 82nd Airborne Army veteran, observing the Ferguson police scene, comment that “We rolled lighter than that in an actual warzone”?\""}]}]},{\""uid\"":\""0385097f47e94debae88dc88c0b93bff\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Olson added, “the dominant visual aspect of the story, however, has been the sight of overpowering police forces confronting unarmed protesters who are seen waving signs or just their hands.”\""}]},{\""uid\"":\""29a61d363134478d9fbcf8eaad59d51f\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""How did this happen?\""}]},{\""uid\"":\""15102dbe95e349fcbb0e22b02bbf28ee\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Most police officers are good cops and good people. It is an unquestionably difficult job, especially in the current circumstances.\""}]},{\""uid\"":\""d3acb41940964cf3962a9593f5e14d59\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""There is a systemic problem with today’s law enforcement.\""}]},{\""uid\"":\""e86f9c1047cb4f05a851ca01d2f21530\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Not surprisingly, big government has been at the heart of the problem. Washington has incentivized the militarization of local police precincts by using federal dollars to help municipal governments build what are essentially small armies—where police departments compete to acquire military gear that goes far beyond what most of Americans think of as law enforcement.\""}]},{\""uid\"":\""5d3531d2c8d44cafab6a29c6d3a9219e\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""This is usually done in the name of fighting the war on drugs or terrorism. \""},{\""uid\"":\""680c3e2346c548c594d6004369f8334e\"",\""type\"":\""a\"",\""attrs\"":{\""url\"":\""http://www.heritage.org/research/reports/2013/08/overmilitarization-why-law-enforcement-needs-to-scale-down-its-use-of-military-hardware-and-tactics\"",\""target\"":\""_blank\""},\""children\"":[{\""text\"":\""The Heritage Foundation’s\""}]},{\""text\"":\"" Evan Bernick wrote in 2013 that, “the Department of Homeland Security has handed out anti-terrorism grants to cities and towns across the country, enabling them to buy armored vehicles, guns, armor, aircraft, and other equipment.”\""}]},{\""uid\"":\""4c3a2dd94e324d8490698f80f550eb0b\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Bernick continued, “federal agencies of all stripes, as well as local police departments in towns with populations less than 14,000, come equipped with SWAT teams and heavy artillery.”\""}]},{\""uid\"":\""734e2ce198034277afe4c3b53027c092\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Bernick noted the cartoonish imbalance between the equipment some police departments possess and the constituents they serve, “today, Bossier Parish, Louisiana, has a .50 caliber gun mounted on an armored vehicle. The Pentagon gives away millions of pieces of military equipment to police departments across the country—tanks included.”\""}]},{\""uid\"":\""cdbeb8e8e81844bcb72cd2c9d8e3e605\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""When you couple this militarization of law enforcement with an erosion of civil liberties and due process that allows the police to become judge and jury—national security letters, no-knock searches, broad general warrants, pre-conviction forfeiture—we begin to have a very serious problem on our hands.\""}]},{\""uid\"":\""4f96dc634cca4a089ee794ba27f44d18\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Given these developments, it is almost impossible for many Americans not to feel like their government is targeting them. Given the racial disparities in our criminal justice system, it is impossible for African-Americans not to feel like their government is particularly targeting them.\""}]},{\""uid\"":\""2eb26550c1c943bf97e2e9f833af1bd6\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""This is part of the anguish we are seeing in the tragic events outside of St. Louis, Missouri. It is what the citizens of Ferguson feel when there is an unfortunate and heartbreaking shooting like the incident with Michael Brown.\""}]},{\""uid\"":\""246da5bfe5694e94add1daec21449b17\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Anyone who thinks that race does not still, even if inadvertently, skew the application of criminal justice in this country is just not paying close enough attention. Our prisons are full of black and brown men and women who are serving inappropriately long and harsh sentences for non-violent mistakes in their youth.\""}]},{\""uid\"":\""d30c2985acb641678ad8f9909e4c9cb4\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""The militarization of our law enforcement is due to an unprecedented expansion of government power in this realm. It is one thing for federal officials to work in conjunction with local authorities to reduce or solve crime. It is quite another for them to subsidize it.\""}]},{\""uid\"":\""3a1e3cc33de54a4ab1aba881634aa926\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Americans must never sacrifice their liberty for an illusive and dangerous, or false, security. This has been a cause I have championed for years, and one that is at a near-crisis point in our country.\""}]},{\""uid\"":\""fc4f36f371f644db91a702869e83348a\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Let us continue to pray for Michael Brown’s family, the people of Ferguson, police, and citizens alike.\""}]},{\""uid\"":\""6180b7973fea4631ad06b4f2e8f2b304\"",\""type\"":\""p\"",\""attrs\"":{},\""children\"":[{\""text\"":\""Paul is the junior U.S. Senator for Kentucky\"",\""italic\"":true},{\""text\"":\"".\""}]}],\""attrs\"":{},\""_version\"":4}}}},\""htmlData\"":\""$7d:props:children:1:props:children:0:props:children:0:props:children:2:0:props:children:0:0:props:children:props:block:html\"",\""isStandardArticle\"":true,\""disableAds\"":true,\""enableDropCap\"":true,\""className\"":\""mb-8\"",\""pageLevelTargetKeyVals\"":{\""type\"":\""article\"",\""ctype\"":\""standard-article\"",\""contentType\"":\""article\"",\""cid\"":\""bltd3dc13479d149ddf\"",\""aid\"":\""bltd3dc13479d149ddf\"",\""primarysection\"":\""ideas\"",\""sections\"":\""us,politics\"",\""tags\"":\""politics,crime,police,race,racism,civil_rights\"",\""vidonpage\"":\""true\"",\""pageHostname\"":\""https://time.com\"",\""adSlotCount\"":\""4\"",\""adSlotCountMobile\"":\""3\"",\""subType\"":\""standard-article\""},\""marfeelSection\"":\""Ideas\"",\""headingIds\"":\""$Q8a\"",\""index\"":0,\""nextBlockName\"":\""\""}]}]],null]}],\""$L8b\"",\""$L8c\"",\""$L8d\"",\""$L8e\"",\""$L8f\"",\""$L90\"",\""$L91\"",\""$L92\"",\""$L93\"",\""$L94\"",\""$L95\"",\""$L96\"",\""$L97\"",\""$L98\"",\""$L99\"",\""$L9a\"",\""$L9b\"",\""$L9c\"",\""$L9d\"",\""$L9e\"",\""$L9f\"",\""$La0\"",\""$La1\"",\""$La2\"",\""$La3\"",\""$La4\"",\""$La5\"",\""$La6\"",\""$La7\"",\""$La8\"",\""$La9\"",\""$Laa\"",\""$Lab\"",\""$Lac\"",\""$Lad\"",\""$Lae\"",\""$Laf\"",\""$Lb0\"",\""$Lb1\"",\""$Lb2\"",\""$Lb3\"",\""$Lb4\"",\""$Lb5\"",\""$Lb6\"",\""$Lb7\"",\""$Lb8\"",\""$Lb9\"",\""$Lba\"",\""$Lbb\"",\""$Lbc\"",\""$Lbd\"",\""$Lbe\"",\""$Lbf\"",\""$Lc0\"",\""$Lc1\"",\""$Lc2\""],false]}],false]}],\""$Lc3\""]}],false]}]\n7e:[\""$\"",\""div\"",null,{\""ref\"":\""$undefined\"",\""className\"":\""container mx-auto max-w-[90rem] px-6 lg:px-20\"",\""children\"":[\""$\"",\