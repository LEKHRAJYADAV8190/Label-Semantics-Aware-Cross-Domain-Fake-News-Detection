s"":false,""primaryCampaign"":null,""primaryCategory"":{""id"":""dmcyOmNhdGVnb3J5OjU4"",""newsletter"":null,""title"":""Tech"",""path"":""/tech"",""parent"":null,""slug"":""tech"",""isHub"":true,""permalink"":""https://www.theverge.com/tech""},""categories"":[{""title"":""Health"",""path"":""/health"",""slug"":""health"",""newsletter"":null,""id"":""dmcyOmNhdGVnb3J5OjE3NA=="",""parent"":{""title"":""Science"",""path"":""/science"",""parent"":null,""id"":""dmcyOmNhdGVnb3J5OjE3MA=="",""permalink"":""https://www.theverge.com/science""},""isHub"":false,""permalink"":""https://www.theverge.com/health""},{""title"":""Science"",""path"":""/science"",""slug"":""science"",""newsletter"":null,""id"":""dmcyOmNhdGVnb3J5OjE3MA=="",""parent"":null,""isHub"":true,""permalink"":""https://www.theverge.com/science""},{""title"":""Sex"",""path"":""/sex"",""slug"":""sex"",""newsletter"":null,""id"":""dmcyOmNhdGVnb3J5OjU1NTk="",""parent"":{""title"":""Health"",""path"":""/health"",""parent"":{""title"":""Science"",""path"":""/science"",""id"":""dmcyOmNhdGVnb3J5OjE3MA=="",""permalink"":""https://www.theverge.com/science""},""id"":""dmcyOmNhdGVnb3J5OjE3NA=="",""permalink"":""https://www.theverge.com/health""},""isHub"":false,""permalink"":""https://www.theverge.com/sex""},{""title"":""Tech"",""path"":""/tech"",""slug"":""tech"",""newsletter"":null,""id"":""dmcyOmNhdGVnb3J5OjU4"",""parent"":null,""isHub"":true,""permalink"":""https://www.theverge.com/tech""}],""internalCategories"":[{""slug"":""us-world"",""id"":""dmcyOmludGVybmFsQ2F0ZWdvcnk6MTIy""}],""internalSuperCats"":[],""blocks"":[{""__isBlockType"":""CoreParagraphBlockType"",""__typename"":""CoreParagraphBlockType"",""paragraphContents"":[{""html"":""Last night, a twitter account by the name of @solikearose tweeted out a surprising image of CNN broadcasting porn instead of Anthony Bourdain\u0026rsquo;s scheduled show \u003cem\u003eParts Unknown. \u003c/em\u003eAnd then without really much questioning, a bunch of news sites ran with it, claiming that the network showed the footage for about 30 minutes. Here are some screenshots \u003ca href=\""http://www.mediaite.com/online/did-the-media-fall-for-a-fake-story-about-cnn-airing-30-minutes-of-hardcore-porn-last-night/\""\u003egrabbed by \u003cem\u003eMediaite\u003c/em\u003e\u003c/a\u003e.""}],""dropcap"":false,""endmark"":false,""lead"":false},{""__isBlockType"":""CoreImageBlockType"",""__typename"":""CoreImageBlockType"",""alt"":"""",""hideCredit"":false,""placement"":""wide"",""credit"":{""html"":"""",""plaintext"":""""},""caption"":{""html"":"""",""plaintext"":""""},""isSensitive"":false,""contentWarning"":{""plaintext"":""""},""thumbnail"":{""size"":""original"",""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7533929/Screen_Shot_2016_11_25_at_10.33.00_AM.jpg?quality=90\u0026strip=all\u0026crop=0,0,100,100"",""normalizedRatio"":1.140496,""originalHeight"":484,""originalWidth"":552,""cropCoordinates"":{""height"":100,""width"":100}},""image"":{""id"":""dmcyOmltYWdlOjI3ODY2Nw=="",""alt"":""""}},{""__isBlockType"":""CoreImageBlockType"",""__typename"":""CoreImageBlockType"",""alt"":"""",""hideCredit"":false,""placement"":""wide"",""credit"":{""html"":"""",""plaintext"":""""},""caption"":{""html"":"""",""plaintext"":""""},""isSensitive"":false,""contentWarning"":{""plaintext"":""""},""thumbnail"":{""size"":""original"",""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7533931/cnns_channel_accidentally_broadcast_hardcore_porn.jpg?quality=90\u0026strip=all\u0026crop=0,0,100,100"",""normalizedRatio"":1.675978,""originalHeight"":358,""originalWidth"":600,""cropCoordinates"":{""height"":100,""width"":100}},""image"":{""id"":""dmcyOmltYWdlOjI3ODY3OQ=="",""alt"":""""}},{""__isBlockType"":""CoreParagraphBlockType"",""__typename"":""CoreParagraphBlockType"",""paragraphContents"":[{""html"":""It looks like the chaos all started when \u003ca href=\""http://www.independent.co.uk/arts-entertainment/tv/news/cnn-accidentally-airs-30-minutes-of-non-stop-hardcore-porn-a7439371.html\""\u003e\u003cem\u003eThe Independent\u003c/em\u003e wrote up a story\u003c/a\u003e from this person\u0026rsquo;s tweets, which was \u003ca href=\""https://twitter.com/DRUDGE_REPORT/status/802202970511151104\""\u003ethen tweeted out by the Drudge Report\u003c/a\u003e. After that, it spread fast. \u003ca href=\""http://mashable.com/2016/11/25/cnn-porn-anthony-bourdain/#SrQmhOdfQ5qP\""\u003e\u003cem\u003eMashable\u003c/em\u003e\u003c/a\u003e\u003cem\u003e, \u003c/em\u003e\u003ca href=\""http://nypost.com/2016/11/25/cnn-accidentally-airs-transsexual-porn-on-thanksgiving/\""\u003e\u003cem\u003eThe New York Post\u003c/em\u003e\u003c/a\u003e\u003cem\u003e, \u003c/em\u003e\u003ca href=\""http://www.dailymail.co.uk/news/article-3972178/Oops-think-parts-known-CNN-accidentally-airs-30-minutes-hardcore-porn-Boston-area-instead-Anthony-Bourdain-s-show.html\""\u003e\u003cem\u003eThe Daily Mail\u003c/em\u003e\u003c/a\u003e\u003cem\u003e, \u003c/em\u003e\u003ca href=\""http://www.esquire.com/news-politics/news/a50979/cnn-porn/\""\u003e\u003cem\u003eEsquire\u003c/em\u003e\u003c/a\u003e\u003cem\u003e, \u003c/em\u003eand \u003ca href=\""http://variety.com/2016/tv/news/cnn-porn-boston-rcn-cable-operator-1201926702/\""\u003e\u003cem\u003eVariety\u003c/em\u003e\u003c/a\u003e have all published a story, and pretty much all of these articles are based on one or two tweets from @solikerose. Plus, many of the original stories didn\u0026rsquo;t include statements from CNN or RCN, the cable company that supposedly aired the porn.""}],""dropcap"":false,""endmark"":false,""lead"":false},{""__isBlockType"":""CoreParagraphBlockType"",""__typename"":""CoreParagraphBlockType"",""paragraphContents"":[{""html"":""Fact-checking largely didn\u0026rsquo;t begin until the stories were published. The @solikearose account has since turned private, and there don\u0026rsquo;t seem to be any reports of porn airing on CNN last night. RCN also released statements on twitter saying there is no evidence that porn was aired last night in Boston, where @solikearose is supposedly based. “We are in the process of researching this incident but see no evidence our CNN network feed was compromised last evening in Boston,” Jeff Carlson, SVP and general manager of RCN Boston, said in a statement to multiple outlets.""}],""dropcap"":false,""endmark"":false,""lead"":false},{""__isBlockType"":""CoreParagraphBlockType"",""__typename"":""CoreParagraphBlockType"",""paragraphContents"":[{""html"":""CNN has also released a statement: \u0026ldquo;The RCN cable operator in Boston aired inappropriate content for 30 minutes on CNN last night. CNN has asked for an explanation.\u0026rdquo; But that still doesn\u0026rsquo;t really verify that anything occurred.""}],""dropcap"":false,""endmark"":false,""lead"":false},{""__isBlockType"":""CoreEmbedBlockType"",""__typename"":""CoreEmbedBlockType"",""embedHtml"":""\u003cfigure class=\""wp-block-embed is-type-rich is-provider-twitter wp-block-embed-twitter alignnone\""\u003e\u003cdiv class=\""wp-block-embed__wrapper\""\u003e\n\u003cblockquote class=\""twitter-tweet\"" data-dnt=\""true\"" align=\""center\""\u003e\u003cp lang=\""en\"" dir=\""ltr\""\u003e800-746-4726. We have not had any reports of the programming issue you mentioned on CNN in Boston. If you\u0026#39;re still having an\u003c/p\u003e\u0026mdash; Astound Broadband (@astoundconnects) \u003ca href=\""https://twitter.com/astoundconnects/status/802163699456872449?ref_src=twsrc%5Etfw\""\u003eNovember 25, 2016\u003c/a\u003e\u003c/blockquote\u003e\u003cscript async src=\""https://platform.twitter.com/widgets.js\"" charset=\""utf-8\""\u003e\u003c/script\u003e\n\u003c/div\u003e\u003c/figure\u003e"",""placement"":""default"",""provider"":""twitter""},{""__isBlockType"":""CoreEmbedBlockType"",""__typename"":""CoreEmbedBlockType"",""embedHtml"":""\u003cfigure class=\""wp-block-embed is-type-rich is-provider-twitter wp-block-embed-twitter alignnone\""\u003e\u003cdiv class=\""wp-block-embed__wrapper\""\u003e\n\u003cblockquote class=\""twitter-tweet\"" data-dnt=\""true\"" align=\""center\""\u003e\u003cp lang=\""en\"" dir=\""ltr\""\u003eissue with that channel, please DM us your address so we can troubleshoot when you\u0026#39;re home. Thanks, Melissa\u003c/p\u003e\u0026mdash; Astound Broadband (@astoundconnects) \u003ca href=\""https://twitter.com/astoundconnects/status/802163864569782272?ref_src=twsrc%5Etfw\""\u003eNovember 25, 2016\u003c/a\u003e\u003c/blockquote\u003e\u003cscript async src=\""https://platform.twitter.com/widgets.js\"" charset=\""utf-8\""\u003e\u003c/script\u003e\n\u003c/div\u003e\u003c/figure\u003e"",""placement"":""default"",""provider"":""twitter""},{""__isBlockType"":""CoreParagraphBlockType"",""__typename"":""CoreParagraphBlockType"",""paragraphContents"":[{""html"":""The appeal of the story is obvious: a network news may have aired porn for a \u003cem\u003efull\u003c/em\u003e 30 minutes. Hilarious! And the CNN program that was supposed to be on was \u003cem\u003eAnthony Bourdain: Parts Unknown\u003c/em\u003e. It\u0026rsquo;s a layup for body-part puns.""}],""dropcap"":false,""endmark"":false,""lead"":false},{""__isBlockType"":""CorePullquoteBlockType"",""__typename"":""CorePullquoteBlockType"",""contents"":{""html"":""This is exactly how fake news spreads""},""citation"":{""html"":""""},""placement"":""left""},{""__isBlockType"":""CoreParagraphBlockType"",""__typename"":""CoreParagraphBlockType"",""paragraphContents"":[{""html"":""But this is exactly how fake news spreads. Even if porn was aired on CNN, it\u0026rsquo;s clear that a lot of publications ran with a story based on tweets from one person before verifying the facts. Many of the headlines already implicate CNN, claiming the channel aired 30 minutes of porn without giving any context.""}],""dropcap"":false,""endmark"":false,""lead"":false},{""__isBlockType"":""CoreParagraphBlockType"",""__typename"":""CoreParagraphBlockType"",""paragraphContents"":[{""html"":""The stakes might not seem very high in this case, but \u003ca href=\""http://www.theverge.com/2016/11/25/13746250/us-election-russia-influence-fake-news-propaganda\""\u003efake news seems to have played a major role during the 2016 presidential campaign\u003c/a\u003e. Mistakes like this won\u0026rsquo;t be very funny when they cost us more than a laugh.""}],""dropcap"":false,""endmark"":false,""lead"":false}],""__isResolvedResourceInterface"":""PostResourceType"",""wpId"":278702,""globalId"":""dmcyOnBvc3Q6Mjc4NzAy"",""__isContentResourceInterface"":""PostResourceType"",""chorusId"":13512267,""chorusUuid"":""f2239eb8-c60a-41f9-80b2-a9fd660fccfd"",""featuredImage"":{""image"":{""originalUrl"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all"",""wpId"":278697,""id"":""dmcyOmltYWdlOjI3ODY5Nw=="",""thumbnails"":{""horizontal"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=0,5.5555555555556,100,88.888888888889""},""square"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=12.5,0,75,100""},""vertical"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=20,0,60,100""},""social"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=0,15.095986038394,100,69.808027923211"",""mimeType"":""imageJpg"",""normalizedRatio"":1.91,""cropCoordinates"":{""height"":69.80802792321117,""width"":100}}},""title"":"""",""alt"":"""",""originalHeight"":768,""originalWidth"":1024},""caption"":{""html"":"""",""plaintext"":""""},""credit"":{""plaintext"":"""",""html"":""""}},""__isFeedContentResourceInterface"":""PostResourceType"",""authors"":[{""id"":""dmcyOmF1dGhvclByb2ZpbGU6NTIzNQ=="",""name"":""Loren Grush"",""permalink"":""https://www.theverge.com/authors/loren-grush"",""shortBio"":[],""profileImage"":{""thumbnails"":{""square"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/author_profile_images/191577/12967452_10107474367893700_4684209358907774999_o.0.jpg?quality=90\u0026strip=all\u0026crop=0,0,100,100""}},""id"":""dmcyOmltYWdlOjUyMzk=""},""title"":""Former Senior Reporter"",""posts"":{""edges"":[{""node"":{""__typename"":""PostResourceType"",""publishedAt"":""2022-09-13T14:00:00+00:00"",""id"":""dmcyOnBvc3Q6MzM5NDM=""}}]}}],""articlePackage"":null,""venues"":{""nodes"":[]},""streams"":{""nodes"":[]},""publishedAt"":""2016-11-25T20:16:56+00:00"",""originalPublishedAt"":""2016-11-25T20:16:56+00:00"",""updatedAt"":null,""createdAt"":""2016-11-25T20:16:56+00:00"",""dek"":{""html"":"""",""plaintext"":""""},""additionalBylines"":"""",""customBadgeEnabled"":false,""customBadgeName"":"""",""site"":{""wpId"":2,""domain"":""www.theverge.com"",""chorusCommunityId"":372,""chorusNetworkId"":2,""isCrossCommunity"":false},""superCats"":[],""ledeMediaData"":{""__typename"":""LedeMediaImageType"",""caption"":{""html"":"""",""plaintext"":""""},""credit"":{""plaintext"":"""",""html"":""""},""hideCredit"":false,""image"":{""thumbnails"":{""horizontal"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=0,5.5555555555556,100,88.888888888889""},""square"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=12.5,0,75,100""},""vertical"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=20,0,60,100""}},""title"":"""",""credit"":{""plaintext"":"""",""html"":""""},""id"":""dmcyOmltYWdlOjI3ODY5Nw==""}},""robots"":{""index"":true,""follow"":true},""canonicalUrlOverride"":"""",""seo"":{""headline"":""The CNN porn scare is how fake news spreads"",""description"":""""},""social"":{""headline"":""The CNN porn scare is how fake news spreads"",""description"":"""",""image"":null},""promo"":{""headline"":""The CNN porn scare is how fake news spreads""},""ledeMedia"":{""__typename"":""LedeMediaImageType"",""image"":{""title"":"""",""alt"":"""",""originalHeight"":768,""originalWidth"":1024,""thumbnails"":{""social"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=0,15.095986038394,100,69.808027923211"",""mimeType"":""imageJpg"",""normalizedRatio"":1.91,""cropCoordinates"":{""height"":69.80802792321117,""width"":100}},""horizontal"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=0,5.5555555555556,100,88.888888888889"",""cropCoordinates"":{""height"":88.88888888888889,""width"":100}},""square"":{""url"":""https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7534089/drudgesiren.jpg?quality=90\u0026strip=all\u0026crop=12.5,0,75,100"",""cropCoordinates"":{""height"":100,""width"":75}}},""id"":""dmcyOmltYWdlOjI3ODY5Nw==""}},""status"":""publish"",""excludedFromHomepage"":false,""packages"":{""nodes"":[]},""wordCount"":420,""package"":null,""liveStatus"":{""startAt"":null,""status"":false,""endAt"":null},""games"":{""nodes"":[]},""isPaywallEligible"":true,""seoArticleBody"":""Last night, a twitter account by the name of @solikearose tweeted out a surprising image of CNN broadcasting porn instead of Anthony Bourdain\u0026rsquo;s scheduled show Parts Unknown. And then without really much questioning, a bunch of news sites ran with it, claiming that the network showed the footage for about 30 minutes. Here are some screenshots grabbed by Mediaite.\n[Image: https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7533929/Screen_Shot_2016_11_25_at_10.33.00_AM.jpg?quality=90\u0026strip=all]\n[Image: https://platform.theverge.com/wp-content/uploads/sites/2/chorus/uploads/chorus_asset/file/7533931/cnns_channel_accidentally_broadcast_hardcore_porn.jpg?quality=90\u0026strip=all]\nIt looks like the chaos all started when The Independent wrote up a story from this person\u0026rsquo;s tweets, which was then tweeted out by the Drudge Report. After that, it spread fast. Mashable, The New York Post, The Daily Mail, Esquire, and Variety have all published a story, and pretty much all of these articles are based on one or two tweets from @solikerose. Plus, many of the original stories didn\u0026rsquo;t include statements from CNN or RCN, the cable company that supposedly aired the porn.\nFact-checking largely didn\u0026rsquo;t begin until the stories were published. The @solikearose account has since turned private, and there don\u0026rsquo;t seem to be any reports of porn airing on CNN last night. RCN also released statements on twitter saying there is no evidence that porn was aired last night in Boston, where @solikearose is supposedly based. “We are in the process of researching\u0026nbsp;this incident but see no evidence our CNN network feed was compromised last evening in Boston,”\u0026nbsp;Jeff Carlson, SVP and general manager of RCN Boston, said in a statement to multiple outlets.\nCNN has also released a statement: \u0026ldquo;The RCN cable operator in Boston aired inappropriate content for 30 minutes on CNN last night. CNN has asked for an explanation.\u0026rdquo; But that still doesn\u0026rsquo;t really verify that anything occurred.\n[Media: https://twitter.com/RCNconnects/status/802163699456872449]\n[Media: https://twitter.com/RCNconnects/status/802163864569782272]\nThe appeal of the story is obvious: a network news may have aired porn for a full 30 minutes. Hilarious! And the CNN program that was supposed to be on was Anthony Bourdain: Parts Unknown. It\u0026rsquo;s a layup for body-part puns.\nBut this is exactly how fake news spreads. Even if porn was aired on CNN, it\u0026rsquo;s clear that a lot of publications ran with a story based on tweets from one person before verifying the facts. Many of the headlines already implicate CNN, claiming the channel aired 30 minutes of porn without giving any context.\nThe stakes might not seem very high in this case, but fake news seems to have played a major role during the 2016 presidential campaign. Mistakes like this won\u0026rsquo;t be very funny when they cost us more than a laugh."",""stickyPackage"":null}},""errors"":[]}]},""nodeId"":""dmcyOnBvc3Q6Mjc4NzAy"",""primaryCategoryNodeId"":""dmcyOmNhdGVnb3J5OjU4"",""primarySuperCatNodeId"":null,""primaryPackageNodeId"":null,""primaryStreamNodeId"":null,""navProps"":{""stickyNav"":{""enable"":true,""headline"":""The CNN porn scare is how fake news spreads"",""streamHeadline"":null,""streamUrl"":null,""packageHeadline"":null,""packageUrl"":null,""isLive"":null,""enableAltTitleInNav"":true},""stickyNavCommentMeta"":{""nodeArgs"":{""chorusId"":13512267,""chorusUuid"":""f2239eb8-c60a-41f9-80b2-a9fd660fccfd"",""globalId"":""dmcyOnBvc3Q6Mjc4NzAy"",""nodeId"":""dmcyOnBvc3Q6Mjc4NzAy""},""url"":""/2016/11/25/13748226/cnn-accidentally-airs-porn-fake-news-boston#comments"",""authorName"":""Loren Grush"",""headline"":""The CNN porn scare is how fake news spreads"",""contentType"":""post""},""variant"":""verge-blurple"",""template"":""fullWidth"",""loopNav"":{""enable"":true}},""mostPopularArticles"":[{""author"":{""fullName"":""Cameron Faulkner""},""image_url"":""https://platform.theverge.com/wp-content/uploads/sites/2/2026/10/268775_